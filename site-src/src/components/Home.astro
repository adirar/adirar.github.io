---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';
import projects from '../data/projects.json';
import pubs from '../data/publications.json';
import extras from '../data/extras.json';

type Track = 'both' | 'ai' | 'xr';
interface Props { track: Track; }
const { track } = Astro.props;

type Project = (typeof projects)['bistro'] & { placeholder?: string };
const P = projects as Record<string, Project>;
const ids = Object.keys(P);
const tracks: Track[] = ['ai', 'xr', 'both'];
const allTracks: Track[] = ['both', 'ai', 'xr'];
const ord = (list: Record<Track, string[]>, id: string) =>
  `--o-both:${list.both.indexOf(id)};--o-ai:${list.ai.indexOf(id)};--o-xr:${list.xr.indexOf(id)}`;
const yt = (id: string) => `https://www.youtube.com/watch?v=${id}`;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const boldMe = (a: string) => esc(a).replace(/(Raikwar, A\.(?: R\.)?)/, '<b>$1</b>');
const artFor = (id: string) => (id === 'agent' ? 'art-agent' : 'art-load');
const cells = Array.from({ length: 240 }, (_, i) => i);
const sections = [['#work', 'Work'], ['#publications', 'Publications'], ['#skills', 'Skills'], ['#kit', 'Lab kit'], ['#connect', 'Connect']];
const clientData = {
  order: site.order,
  playlistId: site.playlistId,
  milestones: site.milestones.map((m) => m.id),
  tracks: Object.fromEntries(allTracks.map((k) => [k, { title: site.tracks[k].title, path: site.tracks[k].path }])),
  projects: Object.fromEntries(ids.map((id) => [id, { title: P[id].title, video: P[id].video }])),
  kit: Object.fromEntries(extras.kit.map((k) => [k.id, { name: k.name, text: k.text }]))
};
---
<Base track={track}>
  <div class="ed-wrap" id="top">
    <div class="ed" data-editor data-sel="root">
      <header class="ed-menu">
        <nav aria-label="Main" class="menu-wide">
          <a class="brand" href="#top"><Icon name="cube" size={18} />Aditya Raikwar</a>
          {sections.map(([h, l]) => <a href={h}>{l}</a>)}
        </nav>
        <a class="brand menu-narrow" href="#top"><Icon name="cube" size={20} /><span>Aditya Raikwar, back to top</span></a>
        <div class="menu-end">
          <button type="button" class="skin-btn" data-skin-toggle><Icon name="skin" size={14} /><span data-skin-label>Light skin</span></button>
          <details class="menu-narrow menu-pop" data-menu>
            <summary>Menu</summary>
            <nav aria-label="Main">{sections.map(([h, l]) => <a href={h}>{l}</a>)}</nav>
          </details>
        </div>
      </header>

      <div class="ed-bar" data-ui>
        <div class="seg icons tools" role="group" aria-label="Scene tools">
          {[['hand', 'Hand tool'], ['move', 'Move tool'], ['rotate', 'Rotate tool'], ['scale', 'Scale tool'], ['rect', 'Rect tool']].map(([n, l]) => (
            <button type="button" data-tool aria-label={l} aria-pressed={n === 'move' ? 'true' : 'false'}><Icon name={n} size={18} /></button>
          ))}
        </div>
        <div class="seg icons" role="group" aria-label="Play controls">
          <button type="button" data-play aria-label="Play demo videos" aria-pressed="false"><Icon name="play" size={14} /></button>
          <button type="button" data-pause aria-label="Stop playback"><Icon name="pause" size={14} /></button>
          <button type="button" data-step aria-label="Next project"><Icon name="step" size={14} /></button>
        </div>
        <div class="track-field">
          <span id="hiring-label">Hiring for</span>
          <nav class="seg" aria-labelledby="hiring-label">
            {tracks.map((k) => (
              <a href={site.tracks[k].path} data-track-link={k} aria-current={k === track ? 'page' : undefined}>{site.tracks[k].label}</a>
            ))}
          </nav>
        </div>
      </div>

      <div class="ed-main">
        <nav class="hier" aria-label="Projects" data-ui>
          <div class="pane-tabs"><span class="pane-tab static">Hierarchy</span></div>
          <div class="hier-search">
            <label><Icon name="search" size={12} /><span class="sr-only">Search projects</span><input type="search" placeholder="Search" data-search autocomplete="off" /></label>
          </div>
          <div class="hier-list">
            <span class="hier-root" style="order:-2"><Icon name="open" size={10} />Portfolio</span>
            <button type="button" class="node root" data-select="root" aria-pressed="true" style="order:-1"><Icon name="cube" size={14} />Aditya Raikwar</button>
            {ids.map((id) => (
              <button type="button" class="node ord" data-select={id} data-label={P[id].label.toLowerCase()} aria-pressed="false" style={ord(site.order as Record<Track, string[]>, id)}><Icon name="cube" size={14} />{P[id].label}</button>
            ))}
          </div>
        </nav>

        <div class="view">
          <div class="pane-tabs" role="tablist" aria-label="Viewport" data-ui>
            <button type="button" role="tab" class="pane-tab" aria-selected="true" aria-controls="viewport" data-view="scene">Scene</button>
            <button type="button" role="tab" class="pane-tab" aria-selected="false" aria-controls="viewport" data-view="game">Game</button>
          </div>
          <div class="view-strip" aria-hidden="true" data-ui><span>Shaded</span><span>2D</span><span>Lighting</span><span>Gizmos</span></div>
          <div class="viewport" id="viewport" role="tabpanel" aria-label="Viewport">
            <div data-pane-scene="root">
              <div class="floor" aria-hidden="true" data-ui>{cells.map(() => <div />)}</div>
              <div class="hero">
                <div class="hero-name">
                  <img src="/images/headshot.jpg" alt="Portrait of Aditya Raikwar" width="96" height="96" data-load style="--d:200ms" />
                  <h1 class="lines"><span class="line"><span data-line>{site.name}</span></span></h1>
                </div>
                <p class="statement" data-load style="--d:360ms">{allTracks.map((k) => <span class={`t-${k}`}>{site.tracks[k].headline}</span>)}</p>
                <p class="sub" data-load style="--d:420ms">{allTracks.map((k) => <span class={`t-${k}`}>{site.tracks[k].sub}</span>)}</p>
                <div class="cta" data-load style="--d:480ms">
                  <a class="pill solid" href="#work">See my work</a>
                  <a class="tlink" href={`mailto:${site.email}`}>Email me</a>
                </div>
                <p class="now" data-load style="--d:540ms">{site.now}</p>
              </div>
            </div>
            {ids.map((id) => (
              <div class="scene-proj" data-pane-scene={id} hidden>
                <div class="media">
                  {P[id].img ? <img src={P[id].img} alt={P[id].alt} loading="lazy" /> : <div class="art"><Icon name={artFor(id)} /></div>}
                </div>
                <div class="foot">
                  <span>{P[id].title}</span>
                  {P[id].video && <button type="button" class="pill solid" data-watch={id}><Icon name="play" size={12} />Watch demo</button>}
                </div>
              </div>
            ))}
            <div class="game" data-game hidden><div data-game-slot style="width:100%;height:100%;display:flex;align-items:center;justify-content:center"></div></div>
            <svg class="gizmo" data-ui role="img" aria-label="Orientation gizmo" width="84" height="84" viewBox="0 0 84 84">
              <circle cx="42" cy="42" r="40" style="fill: var(--panel)" opacity="0.85" />
              <path d="M42 42V14" stroke="#7BC043" stroke-width="3" /><path d="M36 18l6-10 6 10z" fill="#7BC043" />
              <path d="M42 42h28" stroke="#E0574A" stroke-width="3" /><path d="M66 36l10 6-10 6z" fill="#E0574A" />
              <path d="M42 42L24 60" stroke="#4F8BE8" stroke-width="3" /><path d="M20 56l-4 8 8-4z" fill="#4F8BE8" />
              <rect x="37" y="37" width="10" height="10" style="fill: var(--text)" />
              <text x="42" y="10" text-anchor="middle" font-size="9" font-family="sans-serif" style="fill: var(--text)">y</text>
              <text x="79" y="45" text-anchor="middle" font-size="9" font-family="sans-serif" style="fill: var(--text)">x</text>
              <text x="13" y="72" text-anchor="middle" font-size="9" font-family="sans-serif" style="fill: var(--text)">z</text>
            </svg>
          </div>
        </div>

        <aside class="insp" aria-label="Inspector" data-ui>
          <div class="pane-tabs"><span class="pane-tab static">Inspector</span></div>
          <div data-pane-insp="root">
            <div class="insp-head"><span class="check"><Icon name="check" size={10} /></span><span class="field">{site.name}</span></div>
            <div class="insp-meta"><span>Tag <b>Researcher</b></span><span>Layer {allTracks.map((k) => <b class={`t-${k}`}>{site.tracks[k].focus}</b>)}</span></div>
            <div class="comp" aria-hidden="true"><h3><Icon name="closed" size={10} />Transform</h3></div>
            <div class="comp">
              <h3><Icon name="open" size={10} />Profile</h3>
              <div class="body">
                {site.profile.map((f) => <div class="row"><span>{f.k}</span><span class="field">{f.v}</span></div>)}
              </div>
            </div>
            <div class="comp">
              <h3><Icon name="open" size={10} />Top skills</h3>
              <div class="body">
                {allTracks.map((k) => <div class={`chips t-${k}`}>{site.tracks[k].topSkills.map((s) => <span class="chip">{s}</span>)}</div>)}
              </div>
            </div>
            <div class="comp">
              <h3><Icon name="open" size={10} />Links</h3>
              <div class="body" style="flex-direction:row;flex-wrap:wrap;gap:4px 14px">
                <a href={site.links.linkedin}>LinkedIn</a>
                <a href={site.links.scholar}>Google Scholar</a>
                <a href={site.links.github}>GitHub</a>
              </div>
            </div>
          </div>
          {ids.map((id) => (
            <div data-pane-insp={id} hidden>
              <div class="insp-head"><span class="check"><Icon name="check" size={10} /></span><span class="field">{P[id].title}</span></div>
              <div class="insp-meta"><span>Tag <b>Project</b></span><span>Layer {allTracks.map((k) => <b class={`t-${k}`}>{site.tracks[k].focus}</b>)}</span></div>
              <div class="comp" aria-hidden="true"><h3><Icon name="closed" size={10} />Transform</h3></div>
              <div class="comp">
                <h3><Icon name="open" size={10} />Project</h3>
                <div class="body">
                  <span style="color:var(--muted)">{P[id].line}</span>
                  <div class="row"><span>Venue</span><span class="field">{P[id].venue}</span></div>
                </div>
              </div>
              <div class="comp"><h3><Icon name="open" size={10} />Result</h3><p class="result">{P[id].result}</p></div>
              <div class="comp">
                <h3><Icon name="open" size={10} />Stack</h3>
                <div class="body"><div class="chips">{P[id].tags.map((s) => <span class="chip">{s}</span>)}</div></div>
              </div>
              {(P[id].video || P[id].paper) && (
                <div class="insp-actions">
                  {P[id].video && <a class="btn-sq" href={yt(P[id].video)}>Watch on YouTube</a>}
                  {P[id].paper && <a class="btn-sq" href={P[id].paper}>Read the paper</a>}
                </div>
              )}
            </div>
          ))}
          <a class="btn-sq wide" href={`mailto:${site.email}`}>Add to your team</a>
        </aside>
      </div>

      <div class="ed-bottom" data-ui>
        <div class="pane-tabs">
          <div role="tablist" aria-label="Bottom panel" style="display:flex">
            <button type="button" role="tab" class="pane-tab" aria-selected="true" aria-controls="bp-timeline" data-bottom="timeline">Timeline</button>
            <button type="button" role="tab" class="pane-tab" aria-selected="false" aria-controls="bp-console" data-bottom="console">Console</button>
            <button type="button" role="tab" class="pane-tab" aria-selected="false" aria-controls="bp-assets" data-bottom="assets">Project</button>
          </div>
          <span class="hint" data-bottom-hint>Milestones in order. Click one to open it.</span>
        </div>

        <div id="bp-timeline" role="tabpanel" data-bottom-pane="timeline">
          <div class="timeline">
            <div class="lanes-labels mono">
              <span style="height:44px;color:var(--gaze)">Gaze</span>
              <span style="height:44px;color:var(--eeg)">EEG</span>
              <span class="ms" style="height:84px;color:var(--muted)">Milestones</span>
            </div>
            <div class="lanes" data-lanes>
              <svg aria-hidden="true" viewBox="0 0 1200 44" preserveAspectRatio="none"><g class="trace"><path d="M0 22 h70 l8 -15 h90 l6 21 h60 l7 -10 h110 l6 13 h80 l8 -17 h70 l7 8 h78 h70 l8 -15 h90 l6 21 h60 l7 -10 h110 l6 13 h80 l8 -17 h70 l7 8 h78 h70 l8 -15 h90 l6 21 h60 l7 -10 h110 l6 13 h80 l8 -17 h70 l7 8 h78" fill="none" style="stroke: var(--gaze)" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke" /></g></svg>
              <svg aria-hidden="true" viewBox="0 0 1200 44" preserveAspectRatio="none"><g class="trace fast"><path d={'M0 22 ' + Array(3).fill('l10 -6 10 6 10 10 10 -10 10 -4 10 4 10 13 10 -13 10 -7 10 7 10 5 10 -5 10 -14 10 14 10 9 10 -9 10 -3 10 3 10 11 10 -11 10 -6 10 6 10 9 10 -9 10 -5 10 5 10 13 10 -13 10 -8 10 8 10 4 10 -4 10 -10 10 10 10 6 10 -6 10 -12 10 12 10 4 10 -4 10 -9 10 9 10 7 10 -7 10 -15 10 15 10 5 10 -5 10 -10 10 10 10 4 10 -4 10 -11 10 11 10 6 10 -6 10 -9 10 9 10 13 10 -13').join(' ')} fill="none" style="stroke: var(--eeg)" stroke-width="1.5" stroke-linejoin="round" vector-effect="non-scaling-stroke" /></g></svg>
              <div class="miles">
                {site.milestones.map((m) => (
                  <div><button type="button" class="mile" data-select={m.id} aria-pressed="false"><span class="dia" aria-hidden="true"></span><span class="yr mono">{m.year}</span><span class="lb">{m.label}</span></button></div>
                ))}
              </div>
              <div class="playhead" data-playhead hidden></div>
            </div>
          </div>
          <p class="tl-note">Gaze and EEG traces are illustrative, not recorded data.</p>
        </div>

        <ul id="bp-console" role="tabpanel" class="console" data-bottom-pane="console" hidden>
          {site.logs.map((l) => (
            <li><Icon name={l.kind === 'notice' ? 'notice' : 'info'} size={16} /><span class="when mono">{l.when}</span><span>{l.text}</span></li>
          ))}
        </ul>

        <div id="bp-assets" role="tabpanel" class="assets" data-bottom-pane="assets" hidden>
          <p>Assets &gt; Projects</p>
          <div class="asset-grid">
            {ids.map((id) => (
              <button type="button" class="asset ord" data-select={id} aria-pressed="false" style={ord(site.order as Record<Track, string[]>, id)}>
                {P[id].img ? <img src={P[id].img} alt="" loading="lazy" /> : <span class="thumb"><Icon name="cube" size={28} /></span>}
                <span>{P[id].label}</span>
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="status" data-ui><span data-status>Ready</span><span>12 peer-reviewed papers, 6 featured projects</span></div>
    </div>
  </div>

  <main>
    <section id="work" class="sec work">
      <div class="work-head" data-reveal>
        <h2>Things I've built</h2>
        <p>Six projects, from a reusable AR framework to models that predict cognitive load.</p>
      </div>
      <div class="idx" data-idx>
        {ids.map((id) => (
          <article class="proj ord" style={ord(site.order as Record<Track, string[]>, id)} data-proj={id}>
            <button type="button" class="proj-row ord" data-proj-btn={id} aria-pressed="false" aria-controls={`pj-${id}`}>
              <span class="nm">{P[id].label}</span><span class="mt">{P[id].venue}</span>
            </button>
            <div class="proj-body" id={`pj-${id}`} data-proj-body={id}>
              <figure class="proj-media">
                {P[id].img
                  ? <img src={P[id].img} alt={P[id].alt} width="800" height="450" loading="lazy" />
                  : <div class="art"><Icon name={artFor(id)} /><span>{P[id].placeholder}</span></div>}
              </figure>
              <h3>{P[id].title}</h3>
              <p class="line">{P[id].line}</p>
              <p class="res">{P[id].result}</p>
              <p class="stack">{P[id].venue}. {P[id].tags.join(', ')}.</p>
              {(P[id].video || P[id].paper) && (
                <p class="links">
                  {P[id].video && <a href={yt(P[id].video)}>Watch the demo</a>}
                  {P[id].paper && <a href={P[id].paper}>Read the paper</a>}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="publications" class="sec pubs-sec">
      <h2 data-reveal>Publications</h2>
      <p class="lead" data-reveal>12 peer-reviewed papers, plus my PhD and MS theses. Citations are on <a href={site.links.scholar}>Google Scholar</a>.</p>
      <h3 class="grp">Peer-reviewed</h3>
      <ol class="lineup">
        {pubs.peerReviewed.map((p) => (
          <li data-reveal>
            <div class="c-t">
              {p.url ? <a href={p.url}>{p.title}</a> : <span>{p.title}</span>}
              <span class="au" set:html={boldMe(p.authors)} />
            </div>
            <span class="c-v">{p.venue}</span>
            <span class="c-y">{p.year}</span>
          </li>
        ))}
      </ol>
      <h3 class="grp">Theses</h3>
      <ol class="lineup">
        {pubs.theses.map((p) => (
          <li data-reveal>
            <div class="c-t"><a href={p.url}>{p.title}</a></div>
            <span class="c-v">{p.kind}, {p.venue}</span>
            <span class="c-y">{p.year}</span>
          </li>
        ))}
      </ol>
    </section>

    <section id="skills" class="sec skills-sec">
      <h2 data-reveal>Skills</h2>
      <p class="lead" data-reveal>Each group lists the featured projects that use it, not a self-rating.</p>
      <div class="sk-list">
        {Object.entries(extras.skills).map(([k, g]) => (
          <div class="sk ord" style={ord(extras.skillOrder as Record<Track, string[]>, k)} data-cycle data-reveal>
            <p class="sk-line"><span class="sk-k">{g.title}:</span> {g.chips.map((c, i) => <Fragment><span class="sk-i">{c}</span>{i < g.chips.length - 1 ? ', ' : '.'}</Fragment>)}</p>
            <p class="sk-proof">{g.line} Used in {g.projects.length} of {ids.length} featured projects: {g.projects.map((pid, i) => <Fragment><a href="#work" data-proj-link={pid}>{P[pid].label}</a>{i < g.projects.length - 1 ? ', ' : '.'}</Fragment>)}</p>
          </div>
        ))}
      </div>
      <h3 class="grp">Certificates</h3>
      <ul class="lineup certs">
        {extras.certs.map((c) => (
          <li data-reveal>
            <div class="c-t"><a href={c.url}>{c.title}</a></div>
            <span class="c-v">{c.issuer}</span>
            <span class="c-y">{c.date}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="kit" class="sec kit-sec">
      <h2 data-reveal>Lab kit</h2>
      <p class="lead" data-reveal>Hardware I have built and run studies with.</p>
      <div class="kit" data-kit-grid>
        {extras.kit.map((k, i) => (
          <button type="button" class={`kit-item tile-${(i % 3) + 1}`} data-kit={k.id} aria-pressed="false"><Icon name={k.id} size={120} /><span>{k.name}</span></button>
        ))}
      </div>
      <div class="kit-detail" aria-live="polite"><strong data-kit-title>Select an object</strong><span data-kit-text>Pick one of the devices above to see how I have used it.</span></div>
    </section>
  </main>

  <section id="connect" class="contact">
    <h2 data-reveal>Open to applied AI and spatial computing roles.</h2>
    <a class="email" href={`mailto:${site.email}`} data-reveal><span>{site.email.split('@')[0]}@</span><span>{site.email.split('@')[1]}</span></a>
    <ul class="social" aria-label="Elsewhere">
      <li><a href={site.links.linkedin}>LinkedIn</a></li>
      <li><a href={site.links.scholar}>Google Scholar</a></li>
      <li><a href={site.links.github}>GitHub</a></li>
      <li><a href={site.links.youtube}>YouTube demos</a></li>
    </ul>
  </section>

  <footer class="foot">
    <div class="foot-cols">
      <nav aria-label="Sections"><p>Sections</p>{sections.map(([h, l]) => <a href={h}>{l}</a>)}</nav>
      <nav aria-label="Views"><p>Hiring for</p>{tracks.map((k) => <a href={site.tracks[k].path}>{site.tracks[k].label}</a>)}</nav>
      <p class="legal">© 2026 Aditya Raikwar</p>
    </div>
    <p class="wordmark" aria-hidden="true">{site.name}</p>
  </footer>

  <script type="application/json" id="site-data" set:html={JSON.stringify(clientData)} />
  <script>
    import '../scripts/app.ts';
  </script>
</Base>
