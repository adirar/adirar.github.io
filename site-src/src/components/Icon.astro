---
interface Props { name: string; size?: number; }
const { name, size = 16 } = Astro.props;
const s = { fill: 'none', stroke: 'currentColor', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' };
---
{name === 'cube' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 16 16" {...s} stroke-width="1.4"><path d="M8 1.5l6 3.2v6.6L8 14.5 2 11.3V4.7z" /><path d="M2 4.7l6 3.3 6-3.3M8 8v6.5" /></svg>}
{name === 'search' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 16 16" {...s} stroke-width="1.5"><circle cx="7" cy="7" r="5" /><path d="M11 11l3.5 3.5" /></svg>}
{name === 'open' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 10 10"><path d="M1 3h8L5 8z" fill="currentColor" /></svg>}
{name === 'closed' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 10 10"><path d="M3 1l5 4-5 4z" fill="currentColor" /></svg>}
{name === 'hand' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 22 22" {...s} stroke-width="1.5"><path d="M8 12V5.5a1.5 1.5 0 0 1 3 0V11M11 10.5V4a1.5 1.5 0 0 1 3 0v6.5M14 10.5V6a1.5 1.5 0 0 1 3 0v7c0 4-2.5 6.5-6 6.5-2.6 0-4.1-1.1-5.6-3.1L3.8 13a1.5 1.5 0 0 1 2.4-1.8L8 13.5" /></svg>}
{name === 'move' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 22 22" {...s} stroke-width="1.5"><path d="M11 2v18M2 11h18M8 5l3-3 3 3M8 17l3 3 3-3M5 8l-3 3 3 3M17 8l3 3-3 3" /></svg>}
{name === 'rotate' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 22 22" {...s} stroke-width="1.5"><path d="M18 11a7 7 0 1 1-2.2-5.1" /><path d="M18 3v4h-4" /></svg>}
{name === 'scale' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 22 22" {...s} stroke-width="1.5"><rect x="3" y="11" width="8" height="8" /><path d="M11 11l7-7M13 4h5v5" /></svg>}
{name === 'rect' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 22 22" {...s} stroke-width="1.5"><rect x="4" y="5" width="14" height="12" stroke-dasharray="2 2" /><rect x="2.5" y="3.5" width="3" height="3" fill="currentColor" /><rect x="16.5" y="15.5" width="3" height="3" fill="currentColor" /></svg>}
{name === 'play' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 14 14"><path d="M3 1.5v11l9-5.5z" fill="currentColor" /></svg>}
{name === 'pause' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 14 14"><rect x="3" y="2" width="3" height="10" fill="currentColor" /><rect x="8" y="2" width="3" height="10" fill="currentColor" /></svg>}
{name === 'step' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 14 14"><path d="M2 2v10l7-5z" fill="currentColor" /><rect x="10" y="2" width="2" height="10" fill="currentColor" /></svg>}
{name === 'skin' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="8" cy="8" r="6" /><path d="M8 2a6 6 0 0 0 0 12z" fill="currentColor" /></svg>}
{name === 'check' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 10 10"><path d="M1.5 5l2.5 2.5 4.5-5" stroke="#ffffff" stroke-width="1.6" fill="none" /></svg>}
{name === 'linkedin' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" {...s} stroke-width="2"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>}
{name === 'scholar' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" {...s} stroke-width="2"><path d="M2 9l10-5 10 5-10 5-10-5z" /><path d="M6 11v5c3 2 9 2 12 0v-5" /></svg>}
{name === 'github' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" {...s} stroke-width="2"><path d="m8 8-4 4 4 4" /><path d="m16 8 4 4-4 4" /></svg>}
{name === 'youtube' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" {...s} stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="4" /><path d="m10 9 5 3-5 3z" /></svg>}
{name === 'mail' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" {...s} stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>}
{name === 'google' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24"><path fill="#4285F4" d="M12.48 10.92v3.28h7.84c-.24 1.84-.853 3.187-1.787 4.133-1.147 1.147-2.933 2.4-6.053 2.4-4.827 0-8.6-3.893-8.6-8.72s3.773-8.72 8.6-8.72c2.6 0 4.507 1.027 5.907 2.347l2.307-2.307C18.747 1.44 16.133 0 12.48 0 5.867 0 .307 5.387.307 12s5.56 12 12.173 12c3.573 0 6.267-1.173 8.373-3.36 2.16-2.16 2.84-5.213 2.84-7.667 0-.76-.053-1.467-.173-2.053H12.48z" /></svg>}
{name === 'meta' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 24 24"><path fill="#0467DF" d="M6.915 4.03c-1.968 0-3.683 1.28-4.871 3.113C.704 9.208 0 11.883 0 14.449c0 .706.07 1.369.21 1.973a6.624 6.624 0 0 0 .265.86 5.297 5.297 0 0 0 .371.761c.696 1.159 1.818 1.927 3.593 1.927 1.497 0 2.633-.671 3.965-2.444.76-1.012 1.144-1.626 2.663-4.32l.756-1.339.186-.325c.061.1.121.196.183.3l2.152 3.595c.724 1.21 1.665 2.556 2.47 3.314 1.046.987 1.992 1.22 3.06 1.22 1.075 0 1.876-.355 2.455-.843a3.743 3.743 0 0 0 .81-.973c.542-.939.861-2.127.861-3.745 0-2.72-.681-5.357-2.084-7.45-1.282-1.912-2.957-2.93-4.716-2.93-1.047 0-2.088.467-3.053 1.308-.652.57-1.257 1.29-1.82 2.05-.69-.875-1.335-1.547-1.958-2.056-1.182-.966-2.315-1.303-3.454-1.303zm10.16 2.053c1.147 0 2.188.758 2.992 1.999 1.132 1.748 1.647 4.195 1.647 6.4 0 1.548-.368 2.9-1.839 2.9-.58 0-1.027-.23-1.664-1.004-.496-.601-1.343-1.878-2.832-4.358l-.617-1.028a44.908 44.908 0 0 0-1.255-1.98c.07-.109.141-.224.211-.327 1.12-1.667 2.118-2.602 3.358-2.602zm-10.201.553c1.265 0 2.058.791 2.675 1.446.307.327.737.871 1.234 1.579l-1.02 1.566c-.757 1.163-1.882 3.017-2.837 4.338-1.191 1.649-1.81 1.817-2.486 1.817-.524 0-1.038-.237-1.383-.794-.263-.426-.464-1.13-.464-2.046 0-2.221.63-4.535 1.66-6.088.454-.687.964-1.226 1.533-1.533a2.264 2.264 0 0 1 1.088-.285z" /></svg>}
{name === 'info' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 16 16"><circle cx="8" cy="8" r="7" style="fill: var(--muted)" /><path d="M8 7v5M8 4.5v1" style="stroke: var(--panel)" stroke-width="1.6" /></svg>}
{name === 'notice' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 16 16"><path d="M8 1.5l7 12.5H1z" style="fill: var(--accent)" /><path d="M8 6v4M8 11.5v1" stroke="#1c1916" stroke-width="1.6" /></svg>}
{name === 'ar' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 48 48" {...s} stroke-width="1.6"><path d="M6 22c0-5 8-9 18-9s18 4 18 9v4c0 3-2 6-6 6H12c-4 0-6-3-6-6z" /><path d="M10 22h28" /><path d="M14 13c2-4 6-6 10-6s8 2 10 6" /></svg>}
{name === 'vr' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 48 48" {...s} stroke-width="1.6"><rect x="7" y="15" width="34" height="18" rx="7" /><path d="M7 24H3M41 24h4" /><path d="M20 33c1.5-3.5 6.5-3.5 8 0" /><circle cx="16" cy="24" r="3" /><circle cx="32" cy="24" r="3" /></svg>}
{name === 'eye' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 48 48" {...s} stroke-width="1.6"><path d="M4 24s8-12 20-12 20 12 20 12-8 12-20 12S4 24 4 24z" /><circle cx="24" cy="24" r="6" /><circle cx="24" cy="24" r="2" fill="currentColor" /></svg>}
{name === 'eeg' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 48 48" {...s} stroke-width="1.6"><path d="M8 32a16 16 0 0 1 32 0z" /><circle cx="24" cy="20" r="2" /><circle cx="16" cy="24" r="2" /><circle cx="32" cy="24" r="2" /><circle cx="20" cy="28" r="2" /><circle cx="28" cy="28" r="2" /><path d="M40 32c3 3 3 7 0 9" /></svg>}
{name === 'phone' && <svg aria-hidden="true" width={size} height={size} viewBox="0 0 48 48" {...s} stroke-width="1.6"><rect x="15" y="5" width="18" height="38" rx="4" /><path d="M21 38h6" /><path d="M19 15l5-3 5 3v6l-5 3-5-3z" /></svg>}
{name === 'art-load' && <svg aria-hidden="true" width="78%" viewBox="0 0 320 150" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="10" y="10" width="300" height="130" rx="12" style="stroke: var(--line)" stroke-width="2" /><path d="M30 60 h40 l6 -18 h50 l5 24 h40 l6 -12 h60 l6 16 h47" style="stroke: var(--gaze)" stroke-width="3" /><path d="M30 105 l8 -8 8 8 8 14 8 -14 8 -5 8 5 8 17 8 -17 8 -9 8 9 8 6 8 -6 8 -18 8 18 8 11 8 -11 8 -4 8 4 8 14 8 -14 8 -7 8 7 8 12 8 -12 8 -6 8 6 8 15 8 -15 8 -9 8 9 8 5 8 -5" style="stroke: var(--eeg)" stroke-width="2.5" /><rect x="236" y="22" width="60" height="22" rx="11" style="fill: var(--accent)" /><text x="266" y="37" text-anchor="middle" font-size="11" font-family="sans-serif" fill="#1c1916">load: high</text></svg>}
{name === 'art-agent' && <svg aria-hidden="true" width="78%" viewBox="0 0 320 150" fill="none" stroke-linecap="round" stroke-linejoin="round"><rect x="20" y="18" width="170" height="44" rx="14" style="stroke: var(--line); fill: var(--field)" stroke-width="2" /><path d="M40 40 h110" style="stroke: var(--muted)" stroke-width="4" /><rect x="130" y="76" width="170" height="44" rx="14" style="fill: var(--accent)" /><path d="M150 98 h80" stroke="#1c1916" stroke-width="4" /><path d="M36 112 v-10 M46 116 v-18 M56 110 v-6 M66 118 v-22 M76 112 v-10 M86 115 v-16 M96 110 v-6" style="stroke: var(--eeg)" stroke-width="4" /></svg>}
